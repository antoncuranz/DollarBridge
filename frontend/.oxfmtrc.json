{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["src/routeTree.gen.ts"],
  "semi": false,
  "arrowParens": "avoid",
  "printWidth": 80,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "type"
    ],
    "newlinesBetween": false
  }
}
