server {
  listen 3000 default_server;
  server_name _;

  root /var/www;
  index index.html;

  # The backend identifies the user by the headers oauth2-proxy adds to the
  # request (X-Auth-Request-Preferred-Username / Authorization). They are
  # passed on unchanged.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

    # statement PDFs are uploaded and matched by an LLM, which takes a while
    client_max_body_size 25m;
    proxy_read_timeout 300s;
  }

  # hashed file names, cache forever
  location ^~ /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # everything else is a route of the single-page app
  location / {
    add_header Cache-Control "public, max-age=0, must-revalidate" always;
    try_files $uri /index.html;
  }
}
